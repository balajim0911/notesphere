rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helper for Note
    function isValidNote(data) {
      return data.keys().hasAll(['id', 'userId', 'content', 'color', 'position', 'lastModified', 'zIndex'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.content is string && data.content.size() <= 50000
        && data.color is string && data.color.size() <= 32
        && data.position is list && data.position.size() == 3
        && (data.lastModified is int || data.lastModified is number)
        && (data.zIndex is int || data.zIndex is number)
        // Optional fields if present
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('isFavorite' in data) || data.isFavorite is bool)
        && (!('textureType' in data) || (data.textureType is string && data.textureType.size() <= 32))
        && (!('fontStyle' in data) || (data.fontStyle is string && data.fontStyle.size() <= 32))
        && (!('scale' in data) || (data.scale is number || data.scale is int));
    }

    // Notes Collection Rules
    match /notes/{noteId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidNote(request.resource.data);
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid 
        && isValidNote(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Users Collection Rules
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 128
        && (data.email == null || (data.email is string && data.email.size() <= 256))
        && (data.createdAt is int || data.createdAt is number);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow delete: if false; // Users shouldn't delete themselves directly from app
    }

    // Test connection placeholder match rule
    match /test_connection_placeholder/{docId} {
      allow read, write: if true;
    }
  }
}
